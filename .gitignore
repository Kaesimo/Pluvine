node_modules/
dist/
release/
coverage/
.DS_Store
*.log

# packaging artifacts (built by pack:arch / makepkg)
packaging/*.tar.gz
packaging/*.pkg.tar.zst
packaging/src/
packaging/pkg/

# the user's original recordings — never committed (multi-GB; build the
# runtime audio with `npm run sounds:sync`). The folder README stays tracked.
# (Ignore the contents, not the directory — a negation cannot re-include a
# file whose parent directory itself is excluded.)
/sounds/*
!/sounds/README.md

# runtime audio built from sounds/ (the two small thunder one-shots stay
# tracked so a fresh clone runs out of the box)
public/sounds/*
!public/sounds/*-thunder.opus
