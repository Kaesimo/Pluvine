# Maintainer: Kaesimo <kaesimo@localhost>
#
# pluvine-bin — prebuilt Arch package of Pluvine (https://github.com/Kaesimo/Pluvine).
#
# The app is a static web build + a small Electron main process; the package
# depends on the SYSTEM `electron` package instead of bundling another copy,
# so `pacman -S electron` keeps every Electron app up to date at once.
# The tarball comes from the GitHub release (packaging/pluvine-<ver>.tar.gz
# in the source repo, produced by `npm run pack:arch`).

pkgname=pluvine-bin
pkgver=1.0.2
pkgrel=1
pkgdesc="Ambient rain mixer: ten layered recordings, one window, no accounts"
arch=('x86_64')
url="https://github.com/Kaesimo/Pluvine"
license=('LicenseRef-Proprietary')
provides=('pluvine')
conflicts=('pluvine')
depends=('electron')
# No options needed: the payload is pure JS/CSS/HTML/audio, no ELF binaries.

source=("$url/releases/download/v$pkgver/pluvine-$pkgver.tar.gz"
        "pluvine.desktop")
sha256sums=('3562605d3e2696ef0725fd7eead2da2dcf9fcc53be781c0531d39e42f240277a'
            'ab9d2627602d104aef209d9e01d311fd9bda085d0941db0c287801c6d8071890')

build() {
  # Nothing to compile: dist/ is a prebuilt web bundle, electron/ is plain JS.
  :
}

package() {
  # App payload → /opt/pluvine (the launcher passes this path to electron).
  install -d "$pkgdir/opt/pluvine"
  cp -r "$srcdir/package.json" "$srcdir/electron" "$srcdir/dist" \
    "$pkgdir/opt/pluvine/"

  # Launcher → /usr/bin/pluvine: run the SYSTEM electron against /opt app.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/pluvine" <<'EOF'
#!/bin/sh
exec electron /opt/pluvine "$@"
EOF

  # Integration: app menu entry + icon.
  install -Dm644 "$srcdir/pluvine.desktop" \
    "$pkgdir/usr/share/applications/pluvine.desktop"
  install -Dm644 "$srcdir/build/icon.png" \
    "$pkgdir/usr/share/pixmaps/pluvine.png"
}
